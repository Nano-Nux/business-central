# This directory is stored on the VPS NVMe disk. The new VPS has no HDD.
DATA_ROOT=/data/business-central-datastore

# PostgreSQL
POSTGRES_DB=business_central
POSTGRES_USER=business_central
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PUBLIC_PORT=4999

# The Nginx filer proxy checks this exact token. Use a long random value.
# The backend Render variable must be: Bearer <this-same-token>
SEAWEEDFS_AUTH_TOKEN=replace-with-a-long-random-token

# NAT-forwarded HTTP ports
FILE_PUBLIC_PORT=5000
FILER_PUBLIC_PORT=5001

# Remotely-managed Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token

