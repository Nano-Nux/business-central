#!/sbin/openrc-run

name="seaweedfs"
description="Business Central SeaweedFS single-node file service"
command="/usr/local/bin/weed"
command_user="seaweedfs:seaweedfs"
directory="/data/business-central/seaweedfs"
command_args=""
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/seaweedfs.log"
error_log="/var/log/seaweedfs.error.log"

depend() {
  need net
}

start_pre() {
  [ -r /etc/business-central/storage.env ] || { eerror "missing /etc/business-central/storage.env"; return 1; }
  . /etc/business-central/storage.env
  directory="$HDD_ROOT/seaweedfs"
  # The embedded filer store defaults to the process working directory, which
  # is the HDD-backed directory above.
  command_args="server -ip=127.0.0.1 -ip.bind=127.0.0.1 -dir=$HDD_ROOT/seaweedfs/volume -master.dir=$HDD_ROOT/seaweedfs/master -master.peers=none -master.port=9333 -master.volumeSizeLimitMB=512 -master.volumePreallocate=false -master.telemetry=false -volume.max=16 -volume.port=8081 -volume.index=leveldb -volume.dir.idx=$HDD_ROOT/seaweedfs/index -volume.disk=hdd -volume.fileSizeLimitMB=256 -filer=true -filer.port=8888 -filer.port.public=8889 -filer.disableDirListing=true"
  checkpath -f -m 0640 -o seaweedfs:seaweedfs "$output_log"
  checkpath -f -m 0640 -o seaweedfs:seaweedfs "$error_log"
  checkpath -d -m 0750 -o seaweedfs:seaweedfs "$directory"
}
