# DATABASE_URL=postgres://user:password@localhost:5432/business_central?sslmode=disable
DATABASE_URL=postgres://avnadmin:AVNS_RF1MTEdJZkkI6fxU4tu@business-central-antimatter606909-54a5.g.aivencloud.com:18115/defaultdb?sslmode=require

JWT_SECRET=replace-with-at-least-32-random-characters
# Used only when user_identities is empty. The first account becomes the platform admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Legacy explicit platform-admin bootstrap. Used when ADMIN_EMAIL/ADMIN_PASSWORD are not set.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=*
SEAWEEDFS_FILER_URL=http://localhost:8888
# Complete HTTP Authorization header sent from the backend to the filer.
# Leave empty only when the filer endpoint is intentionally unauthenticated.
SEAWEEDFS_FILER_AUTHORIZATION=
APP_ENV=development
AUTO_MIGRATE=true
AUTO_INIT_SCHEMA=false
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=336h
BCRYPT_COST=12


GEMINI_API_KEY=
QUERY_GENERATE_AI_MODEL=gemini-3.5-flash-lite
QUERY_GENERATE_AI_MODEL_FALL_BACK=gemini-3.1-flash-lite
HUMANIZER_AI_MODEL=gemma-4-31b
HUMANIZER_AI_MODEL_FALL_BACK=gemma-4-27b
GROQ_CLOUD_API_KEY=
# Shared platform Telegram bot. Token and webhook secret must stay server-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# 32-256 letters, numbers, underscores, or hyphens. Register via Admin > Telegram groups.
TELEGRAM_WEBHOOK_SECRET=

# Platform public receptionist: separate configuration from merchant analytics AI.
# Empty receptionist key falls back to GEMINI_API_KEY. All credentials stay backend-only.
RECEPTIONIST_GEMINI_API_KEY=
RECEPTIONIST_AI_MODEL=gemini-2.5-flash
# Base64-encoded random 32-byte AES key; keep stable after connecting Google.
RECEPTIONIST_ENCRYPTION_KEY=
RECEPTIONIST_GOOGLE_CLIENT_ID=
RECEPTIONIST_GOOGLE_CLIENT_SECRET=
RECEPTIONIST_GOOGLE_REDIRECT_URL=
RECEPTIONIST_ADMIN_URL=
