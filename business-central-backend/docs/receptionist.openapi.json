{
  "openapi": "3.0.3",
  "info": {
    "title": "Nanonux Public Receptionist API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/public/receptionist/status": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Read public availability status",
        "description": "",
        "operationId": "getApiV1PublicReceptionistStatus",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "greeting": {
                          "type": "string"
                        },
                        "timezone": {
                          "type": "string"
                        },
                        "calendar_connected": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/receptionist/conversations": {
      "post": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Start a visitor conversation",
        "description": "Receptionist must be enabled. Returns the raw random session capability once. Store it in tab-scoped session storage; never put it in a URL.",
        "operationId": "postApiV1PublicReceptionistConversations",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "conversation": {
                          "$ref": "#/components/schemas/Conversation"
                        },
                        "token": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/receptionist/conversations/{id}": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Read own transcript and bookings",
        "description": "The bearer capability must belong to this conversation and be unexpired. Unknown/wrong/expired capabilities return NOT_FOUND.",
        "operationId": "getApiV1PublicReceptionistConversationsId",
        "security": [
          {
            "ReceptionistSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Conversation"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/public/receptionist/conversations/{id}/messages": {
      "post": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Send a support message",
        "description": "Uses persisted history, approved knowledge and only the check_calendar_slots tool. Plain text output. Max 4KB UTF-8 input; bounded history, tool rounds and daily chat turn quota.",
        "operationId": "postApiV1PublicReceptionistConversationsIdMessages",
        "security": [
          {
            "ReceptionistSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Conversation"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/public/receptionist/conversations/{id}/slots": {
      "post": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Check and record available appointments",
        "description": "Date uses the configured business timezone. Applies working days/hours, duration, >1 hour lead time, 60-day horizon, Google free/busy and local reservations. Stores the offered slots in the transcript, valid for 15 minutes.",
        "operationId": "postApiV1PublicReceptionistConversationsIdSlots",
        "security": [
          {
            "ReceptionistSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Slot"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "date"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/public/receptionist/conversations/{id}/bookings": {
      "post": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Confirm or retry a visitor-approved appointment",
        "description": "Requires confirmed=true and a recently offered slot. Rechecks policy and Google availability. Uses request_id as the durable booking ID and deterministic Google event ID. Changed details on retry return IDEMPOTENCY_CONFLICT. One active booking per conversation. BOOKING_PENDING is a 503 with an uncertain provider outcome; retry identical details. Google guest notifications are requested.",
        "operationId": "postApiV1PublicReceptionistConversationsIdBookings",
        "security": [
          {
            "ReceptionistSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/admin/receptionist/conversations": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "List all platform conversations",
        "description": "Platform administrators only; merchant users are forbidden. Returns data[] plus meta {total,limit,offset}. Newest activity/creation first; no tenant selector applies.",
        "operationId": "getApiV1AdminReceptionistConversations",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Conversation"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/admin/receptionist/conversations/{id}": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Read full platform conversation detail",
        "description": "Platform administrators only. Conversations include full messages and linked bookings. Booking status is the integration creation outcome, not a live mirror of Google edits.",
        "operationId": "getApiV1AdminReceptionistConversationsId",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Conversation"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/admin/receptionist/bookings": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "List all platform bookings",
        "description": "Platform administrators only; merchant users are forbidden. Returns data[] plus meta {total,limit,offset}. Newest activity/creation first; no tenant selector applies.",
        "operationId": "getApiV1AdminReceptionistBookings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "FAILED"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/admin/receptionist/bookings/{id}": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Read full platform booking detail",
        "description": "Platform administrators only. Conversations include full messages and linked bookings. Booking status is the integration creation outcome, not a live mirror of Google edits.",
        "operationId": "getApiV1AdminReceptionistBookingsId",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
