    "/api/v1/admin/receptionist/settings": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Read receptionist settings and integration readiness",
        "description": "Platform administrators only. Secrets are never returned.",
        "operationId": "getApiV1AdminReceptionistSettings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SettingsView"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Replace receptionist settings",
        "description": "Platform administrators only. Validates IANA timezone, unique weekday numbers (Sunday=0), hours, duration, knowledge and quotas. Default enabled=false.",
        "operationId": "putApiV1AdminReceptionistSettings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SettingsView"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/receptionist/google/connect": {
      "post": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Begin Google Calendar OAuth",
        "description": "Platform administrators only. Navigate the browser to the returned backend start URL. A top-level redirect establishes a host-only HttpOnly state cookie before navigating to Google. PKCE and encrypted, 10-minute single-use state protect the exchange.",
        "operationId": "postApiV1AdminReceptionistGoogleConnect",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/receptionist/google/connection": {
      "delete": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Disconnect stored Calendar credential",
        "description": "Platform administrators only. Deletes local credential. Existing Google events remain; revoke the app in Google settings to remove the Google authorization grant too.",
        "operationId": "deleteApiV1AdminReceptionistGoogleConnection",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "connected": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Validation, session, authorization, availability, quota or provider error. BOOKING_PENDING means retry the identical request ID and details; the event may already exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/receptionist/google/start": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Google OAuth start",
        "description": "OAuth browser redirect endpoint. Callback requires matching state cookie and unexpired, single-use state; exchanges code with PKCE. Redirects to configured Admin URL after success. No tokens are returned to the browser.",
        "operationId": "getApiV1PublicReceptionistGoogleStart",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to Google consent or configured Admin URL."
          },
          "default": {
            "description": "Invalid, expired, mismatched or denied OAuth request."
          }
        },
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/public/receptionist/google/callback": {
      "get": {
        "tags": [
          "Receptionist"
        ],
        "summary": "Google OAuth callback",
        "description": "OAuth browser redirect endpoint. Callback requires matching state cookie and unexpired, single-use state; exchanges code with PKCE. Redirects to configured Admin URL after success. No tokens are returned to the browser.",
        "operationId": "getApiV1PublicReceptionistGoogleCallback",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to Google consent or configured Admin URL."
          },
          "default": {
            "description": "Invalid, expired, mismatched or denied OAuth request."
          }
        },
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bc_receptionist_oauth",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ReceptionistSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random conversation-scoped capability, not a merchant JWT. Expires after 30 days."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authenticated platform administrator session."
      }
    },
    "schemas": {
      "Slot": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
