# Business Central Public-Facing Landing & Advertisement Application
# Configuration template for local development and production deployments.

# Server Port
PORT=3002

# Public site canonical base URL (used for canonical links, sitemaps, OpenGraph metadata)
# Production: https://business-central.nanonux.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Business Central backend API base URL
# Local: http://localhost:8080/api/v1
# Production: https://business-central-backend.nanonux.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Merchant portal application URL (used for "Sign In", "Launch App", or merchant CTA links)
# Local: http://localhost:3000
# Production: https://business-central-portal.nanonux.com
NEXT_PUBLIC_PORTAL_URL=https://business-central-portal.nanonux.com

# Search Engine Console Verification IDs (Optional)
# Google Search Console HTML verification tag code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Microsoft Bing Webmaster Tools verification code
NEXT_PUBLIC_BING_VERIFICATION=
# Yandex Webmaster verification code
NEXT_PUBLIC_YANDEX_VERIFICATION=
