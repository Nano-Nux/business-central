APPLICATION_NETWORK_ENVIRONMENT=ONLINE
APPLICATION_ENVIRONMENT=development
APPLICATION_BACKEND_URL=http://10.0.2.2:8080/api/v1
APPLICATION_IS_WEBVIEW=false
APPLICATION_WEBVIEW_URL=http://10.0.2.2:3000

# Android emulator: use 10.0.2.2 for a backend on the development computer.
# Physical devices: use the computer's LAN address, preferably over HTTPS.
# FULLY_OFFLINE mode ignores APPLICATION_BACKEND_URL and never creates a client.
# WebView mode renders APPLICATION_WEBVIEW_URL and uses native Bluetooth printing.
